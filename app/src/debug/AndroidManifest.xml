<?xml version="1.0" encoding="utf-8"?>
<!-- Debug builds only: PICO SpatialUI's own logger at Debug level (0 None, 1 Debug, 2 Info, 3 Error).
     Its gesture detectors log WHY a pinch was not a tap ("entity id is not matched", "pointer is up,
     but point is not match with event verifier"): adb logcat -s SUISpatialGesture LabTap -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <meta-data android:name="pico.spatial.ui.Logger" android:value="1" />
    </application>
</manifest>
